<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="top|left">
        <shape android:shape="rectangle">
            <size android:width="12dp" android:height="2dp" />
            <solid android:color="@color/brand_red" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <item android:gravity="top|left" android:left="0dp" android:top="0dp">
        <shape android:shape="rectangle">
            <size android:width="2dp" android:height="12dp" />
            <solid android:color="@color/brand_red" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
